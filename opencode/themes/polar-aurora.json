{
  "base": {
    "categorical": ["accent", "purple", "cyan", "blue", "yellow", "red"],
    "text": {
      "base": "#d8dfe5",
      "muted": "#5c6b80",
      "action": {
        "primary": { "base": "#d8dfe5", "$hovered": "#92eebb", "$focused": "#101318", "$selected": "#92eebb", "$disabled": "#5c6b80" },
        "secondary": { "base": "#5c6b80", "$hovered": "#d8dfe5" },
        "destructive": { "base": "#de7d8c", "$focused": "#101318", "$disabled": "#5c6b80" }
      },
      "formfield": { "base": "#d8dfe5", "$focused": "#92eebb", "$selected": "#92eebb", "$disabled": "#5c6b80" },
      "feedback": {
        "error": { "base": "#de7d8c" },
        "warning": { "base": "#e2c676" },
        "success": { "base": "#7bdca9" },
        "info": { "base": "#71cfd5" }
      }
    },
    "background": {
      "base": "#101318",
      "raised": { "base": "#161d25", "high": "#1e2a38", "max": "#233446" },
      "action": {
        "primary": { "base": "transparent", "$hovered": "#1a2532", "$focused": "#92eebb", "$selected": "#233446" },
        "secondary": { "base": "transparent", "$hovered": "#1a2532" },
        "destructive": { "base": "#33212a", "$focused": "#de7d8c" }
      },
      "formfield": { "base": "#101318", "$selected": "#233446" },
      "feedback": {
        "error": { "base": "#33212a" },
        "warning": { "base": "#2d291d" },
        "success": { "base": "#162b24" },
        "info": { "base": "#1a2532" }
      }
    },
    "border": { "base": "#1e2a38" },
    "scrollbar": { "base": "#5c6b80" },
    "diff": {
      "text": { "added": "#7bdca9", "removed": "#de7d8c", "context": "#5c6b80", "hunkHeader": "#71cfd5" },
      "background": { "added": "#162b24", "removed": "#33212a", "context": "#101318" },
      "highlight": { "added": "#234336", "removed": "#50303c" },
      "lineNumber": { "text": "#5c6b80", "background": { "added": "#162b24", "removed": "#33212a" } }
    },
    "syntax": {
      "comment": "#66788c",
      "keyword": "#a28ae7",
      "function": "#71a3e0",
      "variable": "#71cfd5",
      "string": "#b58ad9",
      "number": "#e5a178",
      "type": "#e2c676",
      "operator": "#71cfd5",
      "punctuation": "#d8dfe5"
    },
    "markdown": {
      "text": "#d8dfe5",
      "heading": "#71a3e0",
      "link": "#71cfd5",
      "linkText": "#71cfd5",
      "code": "#92eebb",
      "blockQuote": "#5c6b80",
      "emphasis": "#71cfd5",
      "strong": "#d8dfe5",
      "horizontalRule": "#5c6b80",
      "listItem": "#92eebb",
      "listEnumeration": "#92eebb",
      "image": "#a28ae7",
      "imageText": "#71cfd5",
      "codeBlock": "#7bdca9"
    },
    "@dialog": {
      "background": { "base": "#161d25", "action": { "primary": { "$hovered": "#1e2a38" } } }
    }
  },
