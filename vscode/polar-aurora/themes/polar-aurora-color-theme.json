  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#858585", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#b58ad9" }
    },
    {
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": { "foreground": "#71cfd5" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "keyword.other.unit"],
      "settings": { "foreground": "#e5a178" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable.name"],
      "settings": { "foreground": "#71cfd5" }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#dedede" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#a28ae7", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#a28ae7" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"],
      "settings": { "foreground": "#71cfd5" }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.definition.block"],
      "settings": { "foreground": "#dedede" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#71a3e0" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#e2c676" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#de7d8c" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": { "foreground": "#7bdca9", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": { "foreground": "#8bb5e9" }
    },
    {
      "scope": ["support.variable", "support.constant"],
      "settings": { "foreground": "#71cfd5" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ea94a1" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#e2c676", "fontStyle": "strikethrough" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#71a3e0", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#e2c676", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#a28ae7", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.raw"],
      "settings": { "foreground": "#92eebb" }
    },
    {
      "scope": ["markup.fenced_code.block", "markup.raw.block"],
      "settings": { "foreground": "#7bdca9" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#777777", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#71cfd5" }
    },
    {
      "scope": ["markup.list", "punctuation.definition.list.begin"],
      "settings": { "foreground": "#92eebb" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#7bdca9" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#de7d8c" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#71a3e0" }
    },
    {
      "scope": ["meta.diff.header", "meta.diff.range"],
      "settings": { "foreground": "#a28ae7" }
    }
  ],
  "semanticTokenColors": {
    "class": "#e2c676",
    "interface": "#e2c676",
    "enum": "#e2c676",
    "struct": "#e2c676",
    "type": "#e2c676",
    "typeParameter": "#ecd58f",
    "namespace": "#e2c676",
    "function": "#71a3e0",
    "method": "#71a3e0",
    "macro": "#a28ae7",
    "property": "#8bb5e9",
    "variable": "#71cfd5",
    "parameter": "#dedede",
    "enumMember": "#e5a178",
    "keyword": "#a28ae7",
    "string": "#b58ad9",
    "number": "#e5a178",
    "comment": "#858585",
    "*.readonly": { "fontStyle": "" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
